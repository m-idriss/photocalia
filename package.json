{
  "name": "photocalia",
  "version": "4.10.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "blog:generate": "node scripts/generate-blog.mjs",
    "blog:check": "node scripts/generate-blog.mjs --check",
    "claims:check": "node scripts/check-public-claims.mjs",
    "fixtures:generate": "node scripts/generate-golden-fixtures.mjs",
    "fixtures:check": "node scripts/check-golden-dataset.mjs",
    "contracts:update": "node scripts/update-api-contract.mjs && npm run contracts:generate",
    "contracts:generate": "openapi-typescript contracts/3dime-api/openapi-v1.json -o src/app/generated/3dime-api.ts",
    "contracts:check": "node scripts/check-api-contract.mjs",
    "prestart": "npm run blog:generate",
    "start": "ng serve",
    "dev": "ng serve",
    "prebuild": "npm run blog:generate",
    "build": "ng build",
    "build:ci": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run blog:generate",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "verify:clean": "node scripts/verify-clean-tree.mjs",
    "verify:frontend": "npm run blog:check && npm run claims:check && npm run fixtures:check && npm run contracts:check && npm run lint && npm run test:ci && npm run build:ci && npm run verify:clean",
    "serve:ng": "ng serve --configuration=local",
    "vercel-build": "node scripts/set-env.js && ng build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write --parser angular"
    ],
    "*.scss": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.1"
    },
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vercel/static-config": {
      "ajv": "8.20.0"
    },
    "@vercel/python-analysis": {
      "js-yaml": "5.2.3",
      "smol-toml": "1.7.1"
    },
    "@vercel/node": {
      "path-to-regexp": "6.3.0",
      "undici": "7.29.0"
    },
    "esbuild": "0.28.1",
    "minimatch": "10.2.4",
    "rollup": "^4.59.0",
    "tar": "^7.5.8",
    "flatted": "3.4.2",
    "socket.io-parser": "4.2.7",
    "undici": "7.29.0"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@fullcalendar/angular": "^7.0.2",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bootstrap": "^5.3.8",
    "cal-heatmap": "^4.2.4",
    "firebase": "^12.14.0",
    "ical.js": "^2.2.1",
    "pdfjs-dist": "^6.0.227",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^26.1.1",
    "@vercel/functions": "^3.8.0",
    "@vercel/node": "^5.8.22",
    "angular-eslint": "^22.1.0",
    "eslint": "10.5.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^17.0.8",
    "marked": "^18.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.1"
  }
}
