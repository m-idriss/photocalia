{
  "name": "photocalia",
  "version": "4.9.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "blog:generate": "node scripts/generate-blog.mjs",
    "blog:check": "node scripts/generate-blog.mjs --check",
    "prestart": "npm run blog:generate",
    "start": "ng serve",
    "dev": "ng serve",
    "prebuild": "npm run blog:generate",
    "build": "ng build",
    "build:ci": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run blog:generate",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "verify:clean": "node scripts/verify-clean-tree.mjs",
    "verify:frontend": "npm run blog:check && npm run lint && npm run test:ci && npm run build:ci && npm run verify:clean",
    "serve:ng": "ng serve --configuration=local",
    "vercel-build": "node scripts/set-env.js && ng build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write --parser angular"
    ],
    "*.scss": [
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": "10.2.4",
    "rollup": "^4.59.0",
    "tar": "^7.5.8",
    "flatted": "3.4.2",
    "socket.io-parser": "4.2.6",
    "undici": "7.24.5"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.1",
    "@angular/cdk": "22.0.1",
    "@angular/common": "22.0.1",
    "@angular/compiler": "22.0.1",
    "@angular/core": "22.0.1",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "@angular/platform-server": "22.0.1",
    "@angular/router": "22.0.1",
    "@angular/service-worker": "22.0.1",
    "@angular/ssr": "22.0.1",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bootstrap": "^5.3.8",
    "cal-heatmap": "^4.2.4",
    "firebase": "^12.14.0",
    "ical.js": "^2.2.1",
    "pdfjs-dist": "^6.0.227",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/localize": "22.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.9.3",
    "@vercel/node": "^5.8.17",
    "angular-eslint": "22.0.0",
    "eslint": "10.5.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^17.0.7",
    "marked": "^18.0.5",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.1"
  }
}
