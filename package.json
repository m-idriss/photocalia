{
  "name": "photocalia",
  "version": "4.5.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "serve:ng": "ng serve --configuration=local",
    "vercel-build": "node scripts/set-env.js && ng build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write --parser angular"
    ],
    "*.scss": [
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": "10.2.4",
    "rollup": "^4.59.0",
    "tar": "^7.5.8",
    "flatted": "3.4.2",
    "socket.io-parser": "4.2.6",
    "undici": "7.24.5"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.5",
    "@angular/cdk": "21.2.3",
    "@angular/common": "21.2.5",
    "@angular/compiler": "21.2.5",
    "@angular/core": "21.2.6",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "21.2.5",
    "@angular/platform-browser": "21.2.5",
    "@angular/platform-server": "21.2.5",
    "@angular/router": "21.2.5",
    "@angular/service-worker": "21.2.5",
    "@angular/ssr": "21.2.3",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bootstrap": "^5.3.8",
    "cal-heatmap": "^4.2.4",
    "firebase": "^12.9.0",
    "ical.js": "^2.2.1",
    "pdfjs-dist": "^5.4.624",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "21.2.5",
    "@angular/localize": "21.2.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.2.1",
    "angular-eslint": "21.3.1",
    "eslint": "10.1.0",
    "husky": "^9.1.7",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.57.2"
  }
}
